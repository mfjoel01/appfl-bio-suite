# Globus Compute multi-user endpoint template for {{ site_name }} ({{ client_id }}).
#
# Generated by `appfl-bio-suite partner-bundle` from the coordinator's federation config.
# Every value is already filled in for your cluster -- check the account and
# {{ scheduler_slot }} below are the ones you want to use, then install this as
#     ~/.globus_compute/{{ endpoint_name }}/user_config_template.yaml.j2
#
# Each worker_init line prevents a specific failure. Please keep all of them; see Part 1
# of your setup guide for what each one is for.

engine:
  type: GlobusComputeEngine
  max_workers_per_node: 1
  strategy: simple
{%- if interface %}
  # Your compute nodes are reached over this interface. Without it the engine cannot
  # always auto-detect the right one, and workers start but never connect back.
  address:
    type: address_by_interface
    ifname: {{ interface }}
{%- endif %}
  provider:
    type: {{ provider_type }}
    account: {{ account }}
    {{ scheduler_slot }}: {{ scheduler_slot_value }}
    nodes_per_block: 1
    init_blocks: 0
    min_blocks: 0
    max_blocks: 1
    walltime: 00:30:00
    launcher:
      type: {{ launcher_type }}
    worker_init: |
{%- if conda_module %}
      module load {{ conda_module }}
{%- endif %}
      source "$(conda info --base)/etc/profile.d/conda.sh"
      conda activate appfl_env
      # Scheduler $TMPDIR paths overflow the ~108-char Unix socket limit and workers
      # then never register ("AF_UNIX path too long").
      export TMPDIR=/tmp
      # numpy's BLAS starts one thread per core on import; on a busy node that exhausts
      # the per-user thread budget ("can't start new thread").
      export OPENBLAS_NUM_THREADS=1
      export OMP_NUM_THREADS=1
      export MKL_NUM_THREADS=1
      export PYTHONUNBUFFERED=1

# Keep the worker block warm between tasks. Without these the block is torn down and
# re-queued each time, which on a busy queue turns minutes into hours.
idle_heartbeats_soft: 0
idle_heartbeats_hard: 5760
