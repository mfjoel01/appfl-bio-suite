#!/bin/bash
set -euo pipefail
: "${FM_ROOT:?}" "${FM_STAGE:?}" "${FM_PYTHON:?}"
export PYTHONPATH="${FM_ROOT}/code/src"
export PATH="${FM_ROOT}/code/vendor/bin:${PATH}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLBACKEND=Agg
cd "${FM_ROOT}/code"
exec > "${FM_ROOT}/logs/${FM_STAGE}.${PBS_JOBID}.${PBS_ARRAY_INDEX:-0}.log" 2>&1
"${FM_PYTHON}" - "${FM_ROOT}" <<'PY'
import hashlib, importlib.metadata, json, sys
from pathlib import Path
root = Path(sys.argv[1])
for name, expected in json.loads((root / "snapshot.json").read_text()).items():
    if hashlib.sha256((root / name).read_bytes()).hexdigest() != expected:
        raise RuntimeError(f"Frozen input changed: {name}")
for name, expected in json.loads((root / "environment.json").read_text())["packages"].items():
    if importlib.metadata.version(name) != expected:
        raise RuntimeError(f"Package version changed: {name}")
print("Frozen source, tools, configurations and package versions verified", flush=True)
PY
case "${FM_STAGE}" in
  validation|merge-validation|phenotypes|merge-phenotypes)
    args=("${FM_STAGE#merge-}" --config "${FM_ROOT}/pipeline_config.yaml" --n-shards 4)
    if [[ "${FM_STAGE}" == *validation ]]; then
      args+=(--n-workers "${FM_WORKERS}")
    fi
    if [[ "${FM_STAGE}" == merge-* ]]; then
      args+=(--merge)
    else
      args+=(--shard-index "${PBS_ARRAY_INDEX:-0}")
    fi
    "${FM_PYTHON}" scripts/fine-mapping/run_stage.py "${args[@]}"
    ;;
  *)
    "${FM_PYTHON}" -m appfl_bio_suite.experiments.fine_mapping.rerun "${FM_STAGE}" \
      --root "${FM_ROOT}" --workers "${FM_WORKERS}" --shards 4
    ;;
esac
