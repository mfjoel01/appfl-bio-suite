Bootstrap: docker
From: ghcr.io/almagx/alma3:3.1.2

%post
    # Match suite metric dependencies without installing the suite or changing Torch.
    python -m pip install --no-deps scikit-learn==1.7.2 scipy==1.16.2 joblib==1.4.2 threadpoolctl==3.6.0
    python -m pip check
    alma3 verify-release

%test
    python -c 'import alma3, torch, sklearn; assert torch.__version__.split("+")[0] == "2.14.1"'
    alma3 verify-release
